doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Employee List
    style.
      body {
        font-family: Arial, sans-serif;
        background-color: #f4f4f4;
        margin: 0;
        padding: 20px;
      }
      h3 a {
        text-decoration: none;
        color: #007BFF;
      }
      form {
        margin-bottom: 20px;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
      }
      th, td {
        padding: 10px;
        border: 1px solid #ddd;
        text-align: left;
      }
      th {
        background-color: #f2f2f2;
      }
      tr:nth-child(even) {
        background-color: #f9f9f9;
      }
  body 
    h3 
      a(href="/emp/create") Add Employee
    div 
      form(action="/emp/search", method="get")
        label(for="keyword") Search:
        input(type="text", id="keyword", name="keyword", placeholder="Search by name")
        button(type="submit") Search
    
    h1 Employee List
    table
      thead
        tr
          th Name
          th Email
          th Phone
          th Action
      tbody
        if employees && employees.length > 0
          each emp in employees
            tr
              td= emp.name
              td= emp.email
              td= emp.phone
              td 
                a(href=`/emp/update/${emp._id}`) Edit
                | 
                a(href=`#`) Delete
        else
          tr
            td(colspan="4") No employees found.