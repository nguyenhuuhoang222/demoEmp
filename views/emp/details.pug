doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title User Detail
    style.
      body {
        font-family: Arial, sans-serif;
        background-color: #f4f4f4;
        margin: 0;
        padding: 20px;
      }
      h1 {
        margin-bottom: 20px;
      }
      div {
        margin-bottom: 10px;
      }
      label {
        font-weight: bold;
      }
      span {
        margin-left: 10px;
      }
  body
    h3 
      a(href="/emp/login") Back to Login
    h1 User Detail
    div
      label Name:
      span= emp.name
    div
      label Email:
      span= emp.email
    div
      label Phone:
      span= emp.phone